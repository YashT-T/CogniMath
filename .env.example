# Copy to .env.local for local development, and add the same two names in Vercel > Project > Settings > Environment Variables.
# Find both in Supabase > Project Settings > API. The anon key is safe in the browser: the row-level security rules protect the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
